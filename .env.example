# Copy to `.env` at repo root for FastAPI + shared keys. Put NextAuth-facing
# values in `frontend/.env.local` too if Next doesn’t inherit the root file.

# --- OpenAI (judge embeddings, benchmarks, FetchDocsAssistant) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- FetchDocsAssistant (Agents SDK): optional overrides ---
# Leave empty to skip FileSearch (Web Search only) — avoids 404 when the id is wrong project/org.
FETCH_DOCS_VECTOR_STORE_ID=
FETCH_DOCS_AGENT_MODEL=gpt-4o
FETCH_DOCS_WORKFLOW_ID=
OPENAI_AGENTS_TRACING_ENABLED=
# 1 = verbose httpx/OpenAI INFO in API logs (default quiet in main bootstrap).
HTTP_LOG_DEBUG=

# --- Optional local RAG (Innovation Labs markdown on disk) ---
INNOVATION_LABS_DOCS=
INNOVATION_LAB_AGENTS=
DOC_URL_MANIFEST=
INNOVATION_LABS_DOC_BASE=https://innovationlab.fetch.ai/resources/docs

# --- FastAPI ---
PORT=8000
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Frontend ``lib/api.ts`` sends ``eval_profile: fast`` by default (override with ``"full"`` in options).
EVAL_PERSIST_CLONE=
# asyncio.to_thread pool for concurrent MCP + /evaluate (default 12, max 32).
EVAL_THREAD_POOL_WORKERS=12
PROMPTS_DIR=
# MCP (SSE) — mount at /mcp by default; GET /meta/mcp for full URL to register in another client
MCP_ENABLED=true
MCP_MOUNT_PATH=/mcp
# If the API is behind a proxy, set the public origin so /meta/mcp returns the correct SSE URL
# AND so MCP DNS-rebinding protection allows the proxied Host/Origin headers.
MCP_PUBLIC_BASE_URL=
# Set to 1 to disable MCP DNS-rebinding protection entirely (use only behind a trusted proxy).
MCP_ALLOW_ANY_HOST=
# Optional comma-separated extras (in addition to MCP_PUBLIC_BASE_URL + localhost defaults).
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
MAX_SUGGESTIONS=15
RAG_TOP_K=16
BM25_WEIGHT=0.3
SEMANTIC_WEIGHT=0.7

# --- GitHub (optional PAT fallback for issues; users normally use OAuth) ---
GITHUB_TOKEN=
GITHUB_AUTO_ISSUE=true

# --- Judge / prompts ---
REVIEW_MODE=strict_reviewer

# --- NextAuth (GitHub OAuth) ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GITHUB_OAUTH_ID=
GITHUB_OAUTH_SECRET=
# Alternates recognised by NextAuth wrapper:
GITHUB_ID=
GITHUB_SECRET=

# --- Frontend → Backend ---
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
BACKEND_API_URL=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
# Optional alias (FastAPI only):
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin JWT (/admin) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_JWT_SECRET=

# --- Optional: uAgent HTTP bridge (frontend routes under /api/uagent/*) ---
UAGENT_HTTP_BASE=
NEXT_PUBLIC_UAGENT_HTTP=
ASI_ONE_API_KEY=
