# Frontend (Next.js) — Vercel environment variables.
# For local dev, copy to `frontend/.env.local`. Never commit `.env.local`.
# Backend + shared values: see root `.env.example`.

# --- Backend API ---
# Browser-visible URL (Render service). Production example:
#   NEXT_PUBLIC_API_URL=https://hackathon-evaluator-api.onrender.com
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Server-side URL used by Next API routes (`app/api/**`). Defaults to NEXT_PUBLIC_API_URL.
BACKEND_API_URL=

# --- NextAuth (GitHub OAuth) ---
# Set NEXTAUTH_URL to the deployed Vercel URL in production, e.g.
#   NEXTAUTH_URL=https://hackathon-evaluator-one.vercel.app
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GITHUB_OAUTH_ID=
GITHUB_OAUTH_SECRET=
# Alternates accepted by the NextAuth wrapper:
GITHUB_ID=
GITHUB_SECRET=

# --- Supabase (used by results / persistence reads) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Admin UI (/admin) — same secrets the FastAPI backend uses ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_JWT_SECRET=

# --- Optional: uAgent HTTP bridge ---
UAGENT_HTTP_BASE=
NEXT_PUBLIC_UAGENT_HTTP=
ASI_ONE_API_KEY=
